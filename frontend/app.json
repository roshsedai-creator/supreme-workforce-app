{
  "expo": {
    "name": "Supreme Compliance",
    "slug": "supreme-sop-gen",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/supreme-logo.png",
    "scheme": "supremecompliance",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/supreme-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.supremehospitality.compliance"
    },
    "android": {
      "package": "com.supremehospitality.compliance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/supreme-logo.png",
        "backgroundColor": "#0a0a14"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/supreme-logo.png",
      "name": "Supreme Compliance",
      "shortName": "Supreme Compliance",
      "description": "Supreme Hospitality Services — SOPs & Compliance Document Generator",
      "backgroundColor": "#0a0a14",
      "themeColor": "#7B2D8E",
      "orientation": "any",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "prefer_related_applications": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/supreme-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a14"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad4e1aa3-730a-4079-bec9-5dec4c572793"
      }
    }
  }
}
