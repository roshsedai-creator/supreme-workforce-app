{
  "expo": {
    "name": "Supreme SOP Generator",
    "slug": "supreme-sop-gen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "supremeworkforce",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.supremehospitality.workforce",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to verify you're at the work site when clocking in/out.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos for timesheet verification.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to attach proof for timesheets."
      }
    },
    "android": {
      "package": "com.supremehospitality.workforce",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Supreme Hospitality Services — SOP Generator",
      "shortName": "Supreme SOPs",
      "description": "Supreme Hospitality Services — SOPs & Compliance Document Generator for Outsourced Housekeeping",
      "backgroundColor": "#0a0a14",
      "themeColor": "#7B2D8E",
      "orientation": "any",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "prefer_related_applications": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Supreme Workforce to use your location to verify work site attendance."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Supreme Workforce to access your photos to attach proof for timesheets.",
          "cameraPermission": "Allow Supreme Workforce to access your camera to take photos for timesheet verification."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a1a2e"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad4e1aa3-730a-4079-bec9-5dec4c572793"
      }
    }
  }
}
